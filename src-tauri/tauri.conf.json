{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winx-island",
  "version": "0.1.0",
  "identifier": "dev.bytezer.winxisland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
